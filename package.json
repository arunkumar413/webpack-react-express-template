{
  "name": "webpack-react-express-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "predev": "node scripts/free-dev-ports.js",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "seed:demo": "npm --prefix server run seed:demo",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
